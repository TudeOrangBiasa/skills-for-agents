# Managed by setup-repo install-timers (issue #78). Remove with: install-timers uninstall.
[Unit]
Description=Runner fix-ci pass every few minutes (opt-in, team repos)

[Timer]
OnBootSec={{FIXCI_BOOT_SEC}}
OnUnitActiveSec={{FIXCI_EVERY}}
Persistent=true
RandomizedDelaySec={{FIXCI_JITTER}}

[Install]
WantedBy=timers.target
