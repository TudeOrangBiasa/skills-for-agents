# Managed by setup-meta install-timers (issue #78). Remove with: install-timers uninstall.
[Unit]
Description=Runner issue triage pass before the queue (opt-in)

[Timer]
OnBootSec={{TRIAGE_BOOT_SEC}}
OnUnitActiveSec={{TRIAGE_EVERY}}
Persistent=true
RandomizedDelaySec={{TRIAGE_JITTER}}

[Install]
WantedBy=timers.target
