# Managed by setup-meta install-timers (issue #78). Remove with: install-timers uninstall.
[Unit]
Description=Runner fix-ci, one pass for team repos with CI (opt-in)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{RUNNER_SH_ABS}} fix-ci
Environment=PATH={{PATH_VALUE}}
EnvironmentFile=-{{ENV_FILE}}
TimeoutStartSec={{TIMEOUT_MIN}}min
