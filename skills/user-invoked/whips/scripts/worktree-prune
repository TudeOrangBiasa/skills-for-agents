#!/usr/bin/env bash
# worktree-prune: delete safe-to-prune worktrees after PR merge/close (issue #83).
#
# Consumes worktree-audit (read-only classification); this script is the only
# writer. Default is --dry-run: print the plan, change nothing. Auto-removal
# applies ONLY to bucket safe-to-prune: PR merged or closed AND working tree
# clean AND not the main worktree AND not claimed by a live runner run (the
# runner's state `active` file, matched by issue number parsed from the path).
# Dirty worktrees are reported with a status summary and never touched.
# Exit 0 always on success (a held-back worktree is a report row, not an error).
#
# Bounds: one `git worktree list` plus one batched `gh pr list` per repo
# (inside the audit call), O(1) status per worktree, O(w_safe) removes, one
# `git worktree prune` plus one `git fetch --prune` per repo (never per worktree).
#
# Usage: worktree-prune [--dry-run] [--apply] [--all | --pr N] [repo-path]
#        --pr N prunes only the worktree whose branch matches PR N's head.
#        --all also scans RUNNER_WORK_DIR/worktrees plus the given repo.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
DRY=1 PR="" ALL=0 REPO="."
while (($#)); do case "$1" in
  --dry-run) DRY=1; shift ;;
  --apply) DRY=0; shift ;;
  --pr) PR="$2"; shift 2 ;;
  --all) ALL=1; shift ;;
  -h|--help) sed -n '1,24p' "$0"; exit 0 ;;
  *) REPO="$1"; shift ;;
esac; done

command -v jq >/dev/null || { echo "worktree-prune: missing dependency: jq" >&2; exit 2; }
: "${RUNNER_STATE_DIR:=${XDG_STATE_HOME:-$HOME/.local/state}/runner}"
: "${RUNNER_WORK_DIR:=${XDG_CACHE_HOME:-$HOME/.cache}/runner}"

prune_repo() { # toplevel -> summary line; globs in $PR $DRY $pr_head
  local TOP="$1"
  local audit row path branch _size _dirty pr_state bucket
  local w=0 safe=0 dirty=0 held=0 removed=0 pruned_any=0
  audit="$("$HERE/worktree-audit" "$TOP")"
  mapfile -t rows < <(tail -n +2 <<<"$audit")
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r path branch _size _dirty pr_state bucket <<<"$row"
    [[ -z "$pr_head" || "$branch" == "$pr_head" ]] || continue
    [[ "$bucket" == "keep" && -z "$PR" ]] && { w=$((w + 1)); continue; }
    w=$((w + 1))
    if [[ "$bucket" == "needs-look" ]]; then
      dirty=$((dirty + 1))
      printf 'hold dirty: %s (%s uncommitted files)\n' "$path" "$_dirty"
      git -C "$path" status --porcelain 2>/dev/null | head -n 5 | sed "s|^|  |"
      continue
    fi
    if runner_claimed "$path"; then
      held=$((held + 1)); printf 'hold claimed: %s\n' "$path"; continue
    fi
    if [[ "$bucket" != "safe-to-prune" ]]; then
      printf 'keep: %s (branch %s, pr %s)\n' "$path" "$branch" "$pr_state"; continue
    fi
    safe=$((safe + 1))
    if ((DRY)); then
      printf 'would prune: %s (branch %s, pr %s)\n' "$path" "$branch" "$pr_state"
      continue
    fi
    git -C "$TOP" worktree remove "$path" 2>/dev/null || { printf 'hold remove-failed: %s\n' "$path"; continue; }
    if [[ "$pr_state" == "MERGED" && -z "$(git -C "$TOP" branch -r --list "origin/$branch" 2>/dev/null)" ]]; then
      git -C "$TOP" branch -D "$branch" >/dev/null 2>&1 || true
    fi
    pruned_any=1
    removed=$((removed + 1))
    printf 'pruned: %s (branch %s)\n' "$path" "$branch"
  done
  if ((DRY == 0 && pruned_any)); then
    git -C "$TOP" worktree prune
    git -C "$TOP" fetch --quiet --prune origin 2>/dev/null || true
  fi
  printf 'worktree-prune [%s]: scanned=%d safe=%d removed=%d dirty=%d held=%d%s\n' \
    "$TOP" "$w" "$safe" "$removed" "$dirty" "$held" "$(((DRY)) && echo ' (dry-run)' || echo '')"
}

runner_claimed() { # worktree-path -> 0 when a live runner run owns its issue
  local path="$1" base n active
  [[ -f "$RUNNER_STATE_DIR/active" ]] || return 1
  base="$(basename "$path")"
  if [[ "$base" =~ -issue-([0-9]+)- ]]; then n="${BASH_REMATCH[1]}"
  elif [[ "$base" =~ -([0-9]+)-[0-9]{8}- ]]; then n="${BASH_REMATCH[1]}"
  else return 1; fi
  active="$(cat "$RUNNER_STATE_DIR/active" 2>/dev/null || echo "")"
  [[ -n "$active" ]] || return 1
  grep -q " $n$" <<<"$active"
}

cd "$REPO"
TOP="$(git rev-parse --show-toplevel)"
declare -A SEEN=()

pr_head=""
if [[ -n "$PR" ]]; then
  command -v gh >/dev/null 2>&1 || { echo "worktree-prune: --pr needs gh, refusing to touch anything" >&2; exit 0; }
  pr_head="$(gh pr view "$PR" --json headRefName --jq .headRefName 2>/dev/null || echo "")"
  [[ -n "$pr_head" ]] || { echo "worktree-prune: PR $PR head unresolvable, touching nothing" >&2; exit 0; }
fi

prune_repo "$TOP"
if ((ALL)); then
  if [[ -d "$RUNNER_WORK_DIR/worktrees" ]]; then
    for wt in "$RUNNER_WORK_DIR"/worktrees/*; do
      [[ -d "$wt" ]] || continue
      repo="$(git -C "$wt" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print substr($0, 10); exit}')"
      [[ -n "$repo" && "$repo" != "$TOP" && -z "${SEEN[$repo]:-}" ]] || continue
      SEEN["$repo"]=1
      prune_repo "$repo"
    done
  fi
fi
