#!/usr/bin/env bash
# verdict-check stub test: runs the seven fixtures without the forge (issue #75).
# Deps: bash, jq. Run: scripts/verdict-check-test
cd "$(dirname "$0")"
S=./verdict-check
F=./fixtures/verdict-check
pass=0 fail=0
check() { # name fixture want_code [env...]
  local name="$1" fixture="$2" want="$3"; shift 3
  if env VERDICT_CHECK_FIXTURE="$F/$fixture" "$@" "$S" 101 >/dev/null 2>&1; then got=0; else got=$?; fi
  if [[ "$got" == "$want" ]]; then pass=$((pass+1)); printf 'ok %s\n' "$name"
  else fail=$((fail+1)); printf 'FAIL %s: want %s got %s\n' "$name" "$want" "$got"; fi
}
check pass-match pass-match.json 0
check stale-patch stale-patch.json 1
check pass-notes-match pass-notes-match.json 0
check fail fail.json 1
check inconclusive inconclusive.json 1
check no-marker no-marker.json 1
check untrusted-author untrusted-author.json 1
RUNNER_VERDICT_AUTHORS=drive-by-user check allowlisted untrusted-author.json 0 env RUNNER_VERDICT_AUTHORS=drive-by-user
printf '%s passed, %s failed\n' "$pass" "$fail"
[[ "$fail" == 0 ]]
