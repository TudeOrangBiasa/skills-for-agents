#!/usr/bin/env bash
# pr-status: deterministic PR state classifier as JSON (issue #63).
#
# Priority (first match wins):
#   merged > closed > conflict > blocked > red > pending > armed > ready
#
# - merged: state MERGED (base check left to the caller)
# - closed: state CLOSED
# - conflict: mergeable == CONFLICTING
# - blocked: label needs-human present
# - red: a required check concludes failure at the head
# - pending: a required check is still queued/in-progress, mergeable
#   unknown, merge state unknown, or the repo has no required checks
#   (noRequiredChecks: true; solo mode merges on the local verifier,
#   team mode refuses auto-merge itself, see #117)
# - armed: auto-merge enabled and checks green so far
# - ready: required checks green, mergeable, no open fix threads
#
# Only structured forge fields decide state. Comment bodies are never
# read for state and never interpolated into shell. Read-only: no
# labels written, nothing merged, nothing armed.
#
# Usage: pr-status <pr> [--repo owner/repo] [--pretty] [--wait]
#        [--timeout <min>] [--interval <sec>] [--solo]
# Exit codes: 0 ready|armed|merged, 1 pending, 2 red|conflict|blocked,
#   3 closed, 4 timeout waiting.
set -euo pipefail

PR="${1:-}"; shift || true
REPO="" PRETTY=0 WAIT=0 TIMEOUT_MIN=10 INTERVAL=15
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) REPO="$2"; shift 2 ;;
    --pretty) PRETTY=1; shift ;;
    --wait) WAIT=1; shift ;;
    --timeout) TIMEOUT_MIN="$2"; shift 2 ;;
    --interval) INTERVAL="$2"; shift 2 ;;
    -h|--help) sed -n '1,30p' "$0"; exit 0 ;;
    *) echo "pr-status: unknown flag $1" >&2; exit 2 ;;
  esac
done
[[ -n "$PR" ]] || { echo "usage: pr-status <pr> [--repo owner/repo] [--pretty] [--wait]" >&2; exit 2; }

repo_flag=()
[[ -z "$REPO" ]] || repo_flag=(--repo "$REPO")

fetch() { # -> JSON doc for the PR; fields only, never comment bodies
  local doc threads owner name
  doc="$(gh pr view "$PR" "${repo_flag[@]}" \
    --json number,state,mergeable,mergeStateStatus,headRefOid,baseRefName,isCrossRepository,labels,autoMergeRequest,statusCheckRollup 2>/dev/null)"
  if [[ -n "$REPO" ]]; then owner="${REPO%/*}"; name="${REPO#*/}";
  else owner="$(gh repo view --json owner --jq .owner.login 2>/dev/null)"; name="$(gh repo view --json name --jq .name 2>/dev/null)"; fi
  threads="$(gh api graphql -f query='
    query($o: String!, $n: String!, $p: Int!) {
      repository(owner: $o, name: $n) {
        pullRequest(number: $p) { reviewThreads(first: 100) { nodes { isResolved } } }
      }
    }' -f owner="$owner" -f name="$name" -F p="$PR" \
    --jq '[.data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved == false)] | length' 2>/dev/null || echo 0)"
  [[ "$threads" =~ ^[0-9]+$ ]] || threads=0
  jq --argjson unresolved "$threads" '. + {unresolvedThreads: $unresolved}' <<<"$doc"
}

classify() { # doc -> classified doc
  jq -c '
    ([.labels[]? | .name]) as $labels
    | ([.statusCheckRollup[]? | {name: (.name // .context // "?"), conclusion: (.conclusion // .status // "?")}] |
       {req: ., failed: ([.[] | select(.conclusion | test("^(FAILURE|TIMED_OUT|CANCELLED|ACTION_REQUIRED)$"))]),
        pending: ([.[] | select(.conclusion | test("^(QUEUED|IN_PROGRESS|PENDING|WAITING|REQUESTED|EXPECTED)$"))])}) as $c
    | . + {
      labels: $labels,
      required: $c.req,
      failedRuns: ([$c.failed[] | .name]),
      noRequiredChecks: (($c.req | length) == 0),
      autoMerge: (.autoMergeRequest != null)
    } | . + {
      state:
        (if .state == "MERGED" then "merged"
         elif .state == "CLOSED" then "closed"
         elif .mergeable == "CONFLICTING" then "conflict"
         elif ([$labels[] | select(. == "needs-human")] | length) > 0 then "blocked"
         elif ($c.failed | length) > 0 then "red"
         elif (($c.req | length) == 0) then "pending"
         elif ($c.pending | length) > 0 then "pending"
         elif (.mergeable == "UNKNOWN" or .mergeStateStatus == "UNKNOWN") then "pending"
         elif .autoMergeRequest != null then "armed"
         elif (.unresolvedThreads // 0) > 0 then "pending"
         else "ready" end)
    }' <<<"$1"
}

emit() { # doc -> stdout
  if [[ "$PRETTY" == 1 ]]; then jq . <<<"$1"; else jq -c . <<<"$1"; fi
}

code_for() { # state -> exit code
  case "$1" in
    ready|armed|merged) return 0 ;;
    pending) return 1 ;;
    red|conflict|blocked) return 2 ;;
    closed) return 3 ;;
    *) return 2 ;;
  esac
}

deadline=$((SECONDS + TIMEOUT_MIN * 60))
while true; do
  doc="$(fetch)"
  out="$(classify "$doc")"
  state="$(jq -r .state <<<"$out")"
  if [[ "$WAIT" != 1 ]]; then emit "$out"; code_for "$state"; exit $?; fi
  case "$state" in
    merged|closed|conflict|blocked|red|ready) emit "$out"; code_for "$state"; exit $? ;;
  esac
  if (( SECONDS >= deadline )); then emit "$out"; exit 4; fi
  sleep "$INTERVAL"
done
